# Copy to .env in the repository root. Fill both passwords before starting.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lawground
POSTGRES_USER=lawground
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=lawground
RABBITMQ_PASSWORD=

# Spring (prod must be selected explicitly in the deployment environment)
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local

# Future law ingestion: not required for the bootstrap
LAW_GO_KR_API_KEY=

# Future internal Python service. Provider LLM secrets belong to ai-service.
AI_SERVICE_BASE_URL=http://127.0.0.1:8001/internal/v1
AI_SERVICE_API_KEY=
